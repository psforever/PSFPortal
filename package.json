{
  "name": "psfportal",
  "version": "2.0.0",
  "type": "module",
  "description": "A web interface to PSForever servers.",
  "main": "index.ts",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently --kill-others \"npm:dev-client\" \"npm:dev-server\"",
    "dev-client": "vite",
    "dev-server": "node --watch index.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "prod-server": "cross-env NODE_ENV=production node index.ts",
    "production": "npm run build && npm run prod-server"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GeekOfWires/PSFPortal.git"
  },
  "author": "PSForever.net",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/GeekOfWires/PSFPortal/issues"
  },
  "homepage": "https://github.com/GeekOfWires/PSFPortal#readme",
  "dependencies": {
    "body-parser": "^2.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "connect-history-api-fallback": "^2.0.0",
    "dotenv": "^17.0.0",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "lucide-react": "^0.469.0",
    "morgan": "^1.11.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/connect-history-api-fallback": "^1.5.4",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.0",
    "@types/morgan": "^1.9.9",
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
