{
  "name": "psfportal",
  "version": "2.0.0",
  "type": "module",
  "description": "A web interface to PSForever servers.",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently --kill-others \"npm:dev-client\" \"npm:dev-server\"",
    "dev-client": "vite",
    "dev-server": "nodemon -w api/ -w index.js",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "prod-server": "cross-env NODE_ENV=production node index.js",
    "production": "npm run build && npm run prod-server"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GeekOfWires/PSFPortal.git"
  },
  "author": "PSForever.net",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/GeekOfWires/PSFPortal/issues"
  },
  "homepage": "https://github.com/GeekOfWires/PSFPortal#readme",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "connect-history-api-fallback": "^1.6.0",
    "connect-pg-simple": "^6.0.1",
    "dotenv": "^8.2.0",
    "express": "^4.17.1",
    "express-session": "^1.17.0",
    "lucide-react": "^0.469.0",
    "morgan": "^1.9.1",
    "pg": "^8.2.0",
    "pg-error-constants": "^1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.9",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
